	<script language=JavaScript src=/js/md5.js></script>
	<script language=JavaScript src=/js/func_string.js></script>
	<script language=JavaScript>
	function fsubmit_login(){
		myform=document.forms['loginf'];
		myform.login.value=trim(myform.login.value);
		myform.password.value=trim(myform.password.value);
		if(myform.login.value=='' && myform.password.value==''){
			alert('Введите логин и пароль');
			return false;
		}

		if(!CheckStringReg(myform.login.value,regLogin,'Логин')){return false;}
		myform.phash.value=MD5(myform.password.value);
		myform.password.value='';
		return true;
	}
	
	function fsubmit_login_do(){
		if(fsubmit_login()){
			document.forms['loginf'].submit();
			return true;
		}
		else{
			return false;
		}
	}
	
	</script>
	<a name=login></a>
	<form name='loginf' action=/personal/plogin_do.phtml?option_lang=rus method=POST onSubmit="return fsubmit_login()">
	<input type=hidden name=phash value=''>

