	<td align=left><input type=input class=ID size=10 name=login></td>
	</tr>
	<tr>
	<td align=right class=x-bl>Пароль:</td>
	<td align=left><input type=password class=ID size=10 name=password></td>
	</tr>

	<tr>
	<td align=right class=x-bl><input type=checkbox name=if_savelogin></td>
	<td class=x-bl align=left><nobr>Запомнить пароль</nobr></td>
	</tr>

	<tr>
	<td align=right class=x-bl><input type=image src=/images/ar5.gif border=0></td>
	<td align=left><a class=ri href=# onClick="return fsubmit_login_do()">Войти</a></td>
	</tr>

